{
  "name": "distributed-wagering-processor",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "migration:up": "bun run src/infrastructure/persistence/migrate.ts up",
    "migration:down": "bun run src/infrastructure/persistence/migrate.ts down",
    "infra:up": "docker compose up -d --wait postgres localstack",
    "infra:down": "docker compose down -v"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1163.0",
    "@mikro-orm/core": "^7.2.7",
    "@mikro-orm/migrations": "^7.2.7",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.7",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@prometheus-io/client": "^0.16.1",
    "decimal.js": "^10.6.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  }
}
