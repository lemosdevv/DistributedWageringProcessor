PORT=3000
DATABASE_URL=postgres://wagering:wagering@localhost:5433/wagering
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
WAGER_TRANSACTIONS_QUEUE=wager-transactions.fifo
WAGER_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
WALLET_EVENTS_QUEUE=wallet-events.fifo
SQS_WAIT_TIME_SECONDS=10
SQS_RETRY_BASE_SECONDS=2
SQS_RETRY_MAX_SECONDS=300
SHUTDOWN_TIMEOUT_MS=15000
# Papéis desta instância (todos ligados por padrão)
ENABLE_HTTP=true
ENABLE_SQS_CONSUMER=true
ENABLE_OUTBOX_PUBLISHER=true
ENABLE_PENDING_REFERENCE_WORKER=true
LOG_LEVEL=info
